{
  "expo": {
    "name": "odaklanma_takibi_ve_raporlama_uygulamasi",
    "slug": "odaklanma_takibi_ve_raporlama_uygulamasi",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "odaklanmatakibiveraporlamauygulamasi",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.odaklanmatakibiveraporlamauygulamasi"
    },
    "android": {

      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.odaklanmatakibiveraporlamauygulamasi"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png"
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": true,
          "android": {
            "enableFTS": false,
            "useSQLCipher": false
          },
          "ios": {
            "customBuildFlags": ["-DSQLITE_ENABLE_DBSTAT_VTAB=1 -DSQLITE_ENABLE_SNAPSHOT=1"]
          }
        }
      ]


    ]
  }
}
